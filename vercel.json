{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://armanlostfound.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://armanlostfound.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
