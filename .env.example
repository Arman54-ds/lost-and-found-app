# Database Configuration (External MySQL)
# Use DATABASE_URL for a connection string (recommended)
DATABASE_URL=mysql://user:pass@host:port/dbname

# Individual DB fields (fallback)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=lostfound_db

# Email Configuration (Gmail App Password recommended)
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PASS=your_gmail_app_password

# Port (Render will set this automatically)
PORT=5000
